# Copy this file to .env and replace every placeholder before starting Keycloak.
# This file contains examples only; do not commit backend/.env.

KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=hero-association-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-local-admin-password
KEYCLOAK_DATABASE_PASSWORD=replace-with-a-local-database-password
HERO_ASSOCIATION_BFF_OIDC_CLIENT_SECRET=replace-with-a-long-random-local-client-secret
HERO_ASSOCIATION_BFF_OIDC_STATE_SECRET=replace-with-a-long-random-local-state-secret
HERO_ASSOCIATION_BFF_CSRF_TOKEN_SIGNATURE_KEY=replace-with-a-long-random-local-csrf-signing-key

# Local development host ports. Change a value here if it is already in use.
HERO_ASSOCIATION_CORE_DATABASE_HOST_PORT=15431
HERO_ASSOCIATION_BFF_REDIS_HOST_PORT=16379
HERO_ASSOCIATION_BFF_HTTP_PORT=17080
HERO_ASSOCIATION_CORE_HTTP_PORT=17081
HERO_ASSOCIATION_KEYCLOAK_HTTP_PORT=17180
HERO_ASSOCIATION_FRONTEND_HTTP_PORT=15172

# Native Compose host ports. They stay separate from the hot-reload workflow.
HERO_ASSOCIATION_NATIVE_BFF_REDIS_HOST_PORT=19679
HERO_ASSOCIATION_NATIVE_BFF_HTTP_PORT=19080
HERO_ASSOCIATION_NATIVE_KEYCLOAK_HTTP_PORT=19180
