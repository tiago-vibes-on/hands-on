# Copy this file to .env and replace every placeholder before starting Keycloak.
# This file contains examples only; do not commit backend/.env.

KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=hero-association-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-local-admin-password
KEYCLOAK_DATABASE_PASSWORD=replace-with-a-local-database-password
HERO_ASSOCIATION_BFF_OIDC_CLIENT_SECRET=replace-with-a-long-random-local-client-secret
HERO_ASSOCIATION_BFF_OIDC_STATE_SECRET=replace-with-a-long-random-local-state-secret
HERO_ASSOCIATION_BFF_CSRF_TOKEN_SIGNATURE_KEY=replace-with-a-long-random-local-csrf-signing-key

# Local development host ports. Change a value here if it is already in use.
HERO_ASSOCIATION_CORE_DATABASE_HOST_PORT=15431
HERO_ASSOCIATION_BFF_REDIS_HOST_PORT=16379
HERO_ASSOCIATION_CORE_REDIS_HOST_PORT=16380
# Optional private Expedition sandbox; not connected to the live path.
HERO_ASSOCIATION_EXPEDITION_REDIS_HOST_PORT=16381
HERO_ASSOCIATION_EXPEDITION_HTTP_PORT=17083
HERO_ASSOCIATION_EXPEDITION_WORKER_ENABLED=false
HERO_ASSOCIATION_EXPEDITION_SETTLEMENT_ENABLED=false
HERO_ASSOCIATION_CORE_EXPEDITION_ENABLED=false
HERO_ASSOCIATION_EXPEDITION_RABBITMQ_HOST_PORT=15675
HERO_ASSOCIATION_EXPEDITION_RABBITMQ_MANAGEMENT_HOST_PORT=15676
# Setup-only broker admin; never use this account from Core or Expedition.
HERO_ASSOCIATION_EXPEDITION_RABBITMQ_PASSWORD=hero_association_expedition
HERO_ASSOCIATION_EXPEDITION_WORKER_RABBITMQ_PASSWORD=hero_association_expedition_worker
HERO_ASSOCIATION_CORE_SETTLEMENT_RABBITMQ_PASSWORD=hero_association_core_settlement
HERO_ASSOCIATION_BFF_HTTP_PORT=17080
HERO_ASSOCIATION_CORE_HTTP_PORT=17081
HERO_ASSOCIATION_KEYCLOAK_HTTP_PORT=17180
HERO_ASSOCIATION_FRONTEND_HTTP_PORT=15172

# Optional pre-cutover Combat sandbox (compose.combat.yaml).
HERO_ASSOCIATION_COMBAT_DATABASE_HOST_PORT=15432
HERO_ASSOCIATION_COMBAT_HTTP_PORT=17082
HERO_ASSOCIATION_COMBAT_WORKER_ENABLED=false
HERO_ASSOCIATION_COMBAT_OUTBOX_ENABLED=false
HERO_ASSOCIATION_COMBAT_RABBITMQ_HOST_PORT=15673
HERO_ASSOCIATION_COMBAT_RABBITMQ_MANAGEMENT_HOST_PORT=15674
HERO_ASSOCIATION_COMBAT_RABBITMQ_PASSWORD=hero_association_combat
HERO_ASSOCIATION_CORE_COMBAT_INBOX_ENABLED=false

# Native Compose host ports. They stay separate from the hot-reload workflow.
HERO_ASSOCIATION_NATIVE_BFF_REDIS_HOST_PORT=19679
HERO_ASSOCIATION_NATIVE_CORE_REDIS_HOST_PORT=19680
HERO_ASSOCIATION_NATIVE_BFF_HTTP_PORT=19080
HERO_ASSOCIATION_NATIVE_KEYCLOAK_HTTP_PORT=19180

# Market and Assets share this dedicated credential; Core uses a separate key.
HERO_ASSOCIATION_ASSETS_MARKET_SERVICE_KEY=replace-with-a-long-random-market-assets-service-key
HERO_ASSOCIATION_MARKET_DATABASE_PASSWORD=replace-with-a-separate-market-database-password
HERO_ASSOCIATION_MARKET_DATABASE_HOST_PORT=15433
HERO_ASSOCIATION_MARKET_HTTP_PORT=17084

HERO_ASSOCIATION_ASSETS_DATABASE_PASSWORD=replace-with-separate-assets-database-password
HERO_ASSOCIATION_ASSETS_CORE_SERVICE_KEY=replace-with-core-assets-service-key-at-least-32-characters
HERO_ASSOCIATION_ASSETS_DATABASE_HOST_PORT=15435
HERO_ASSOCIATION_ASSETS_HTTP_PORT=17085
