{
  "realm": "hero-association",
  "displayName": "Hero Association",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "sslRequired": "external",
  "loginTheme": "hero-association",
  "users": [
    {
      "id": "019c4c00-0100-7000-8000-000000000001",
      "username": "user1@mail.com",
      "email": "user1@mail.com",
      "firstName": "User",
      "lastName": "1",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "user1",
          "temporary": false
        }
      ]
    },
    {
      "id": "019c4c00-0100-7000-8000-000000000002",
      "username": "user2@mail.com",
      "email": "user2@mail.com",
      "firstName": "User",
      "lastName": "2",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "user2",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "hero-association-core",
      "name": "Hero Association Game Core",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "hero-association-bff",
      "name": "Hero Association BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${HERO_ASSOCIATION_BFF_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/auth/callback",
        "http://localhost:8080/auth/post-logout",
        "http://localhost:18080/auth/callback",
        "http://localhost:18080/auth/post-logout",
        "http://host.docker.internal:15173/auth/callback",
        "http://host.docker.internal:15173/auth/post-logout",
        "https://heroassociation.test/auth/callback",
        "https://heroassociation.test/auth/post-logout"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:18080",
        "http://host.docker.internal:15173",
        "https://heroassociation.test"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "hero-association-core-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "hero-association-core",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
