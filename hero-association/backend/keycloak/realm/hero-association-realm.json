      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:17080/auth/callback",
        "http://localhost:17080/auth/post-logout",
        "http://localhost:19080/auth/callback",
        "http://localhost:19080/auth/post-logout",
        "http://localhost:18080/auth/callback",
