VITE_API_PROXY_TARGET=http://localhost:8080
# Set to false only when a reverse proxy must preserve the browser-visible host
# for an OIDC callback, such as the isolated container-browser E2E workflow.
VITE_API_PROXY_CHANGE_ORIGIN=true
# Comma-separated development hosts that Vite may serve. Leave unset unless a
# controlled environment, such as the E2E browser container, needs one.
VITE_ALLOWED_HOSTS=
